# Copy to backend/.env and set separate random passwords; never commit that file.
# Spring does not automatically load .env. Use scripts/Invoke-Backend.ps1 or export variables.
DB_HOST=localhost
DB_PORT=3308
DB_USERNAME=demo_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SERVER_PORT=8080
JPA_SHOW_SQL=false
# Apply reviewed db/04-booking-attempts.sql before enabling. Existing DBs remain compatible while false.
BOOKING_ATTEMPTS_ENABLED=true
DEMO_JOBS_ENABLED=true
BTS_ENABLED=false
BTS_BASE_URL=
# Choose the assigned service ID before creating demo identities for real delivery.
BTS_SERVICE_ID=demo-ticketing
BTS_API_KEY=
HOLD_DURATION=PT5M
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
QUEUE_KEY_PREFIX=demo-ticketing:queue
QUEUE_CAPACITY=100
QUEUE_WAIT_TTL=PT30M
QUEUE_ADMIT_TTL=PT5M
QUEUE_EXPIRED_RETENTION=PT10M
# disabled=ALLOW, mock=local demo policy, bts=remote QUEUE_JOIN decision (endpoint must exist).
POLICY_DECISION_MODE=disabled
POLICY_MOCK_ACTIONS={}
# disabled=보안 확인 없음, mock=산술 문제(로컬 시연용), hcaptcha=hCaptcha 위젯(아래 키 필요)
CAPTCHA_MODE=disabled
CAPTCHA_CHALLENGE_TTL=PT2M
CAPTCHA_GRANT_TTL=PT2M
CAPTCHA_MAX_ATTEMPTS=5
# CAPTCHA_MODE=hcaptcha 일 때만 사용한다. 발급받은 키는 backend/.env 에만 넣고 이 예시 파일에는 넣지 않는다.
# 처음에는 hCaptcha 공식 문서의 테스트 키로 확인할 수 있다.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
# Apply reviewed db/05-ticket-device-binding.sql before enabling dynamic QR / check-in.
CHECKIN_ENABLED=false
# Base64 of 32 random bytes, e.g. `openssl rand -base64 32`. Changing it invalidates every registered device.
TICKET_SECRET_KEY=
# Gate staff credential (16+ printable ASCII chars), sent by the gate screen as X-Gate-Key.
GATE_API_KEY=
# Admission opens this long before the booked performance start and closes at its end.
CHECKIN_OPENS_BEFORE=PT2H
DEVICE_CHALLENGE_TTL=PT2M
DEVICE_MAX_CHANGES=3
